def charger_cle():
"""Charge ou crée la clé HMAC."""
if KEY_FILE.exists():
return KEY_FILE.read_bytes()
key = secrets.token_bytes(64)
KEY_FILE.write_bytes(key)
try:
os.chmod(KEY_FILE, 0o600)
except OSError:
pass
return key


def hash_multi(data):
"""Génère plusieurs hash pour une donnée."""
if isinstance(data, str):
data = data.encode("utf-8")
return {
"sha256": hashlib.sha256(data).hexdigest(),
"sha512": hashlib.sha512(data).hexdigest(),
"blake2b": hashlib.blake2b(data).hexdigest(),
"blake2s": hashlib.blake2s(data).hexdigest(),
"md5": hashlib.md5(data).hexdigest(),
"sha1": hashlib.sha1(data).hexdigest(),
"sha3_256": hashlib.sha3_256(data).hexdigest(),
"sha3_512": hashlib.sha3_512(data).hexdigest(),
}


def signer_hmac(data, key):
"""Signature HMAC-SHA256."""
if isinstance(data, str):
data = data.encode("utf-8")
return hmac.new(key, data, hashlib.sha256).hexdigest()


def signer_pbkdf2(data, key):
"""Signature PBKDF2-HMAC-SHA512 (plus robuste)."""
if isinstance(data, str):
data = data.encode("utf-8")
return hashlib.pbkdf2_hmac("sha512", data, key, 100000).hex()


def generer_id_signature(data):
"""Génère un ID de signature unique et court."""
h = hashlib.sha256(data.encode("utf-8")).hexdigest()
return "NEXUS-" + h[:16].upper()


