def export_txt(textes, path):
with open(path, "w", encoding="utf-8") as f:
for t in textes:
f.write("=" * 80 + "\n")
f.write(f"TEXTE #{t['id']} — {t['format']} → {t['cible']} ({t['ton']})\n")
f.write(f"ID SIGNATURE : {t['id_signature']}\n")
f.write("=" * 80 + "\n")
f.write(t["sujet"] + "\n\n")
f.write(t["corps"] + "\n\n")
f.write(f"[SHA-256] {t['hashes']['sha256']}\n")
f.write(f"[SHA-512] {t['hashes']['sha512']}\n")
f.write(f"[BLAKE2b] {t['hashes']['blake2b']}\n")
f.write(f"[HMAC] {t['signature_hmac']}\n")
f.write(f"[PBKDF2] {t['signature_pbkdf2']}\n\n\n")


def export_markdown(textes, path):
with open(path, "w", encoding="utf-8") as f:
f.write(f"# NEXUS Ultimate Texts — {len(textes)} générés\n\n")
f.write(f"*Généré le {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}*\n\n---\n\n")
for t in textes:
f.write(f"## Texte #{t['id']} — {t['format']} → {t['cible']}\n\n")
f.write(f"**ID Signature :** `{t['id_signature']}` \n")
f.write(f"**Ton :** {t['ton']} \n")
f.write(f"**Sujet :** {t['sujet']} \n\n")
f.write("```\n" + t["corps"] + "\n```\n\n")
f.write(f"`SHA-256 : {t['hashes']['sha256'][:32]}...` \n")
f.write(f"`HMAC : {t['signature_hmac'][:32]}...`\n\n---\n\n")


def export_csv(textes, path):
import csv
with open(path, "w", encoding="utf-8", newline="") as f:
w = csv.writer(f)
w.writerow(["id", "id_signature", "format", "cible", "ton",
"sujet", "longueur", "sha256", "hmac"])
for t in textes:
w.writerow([t["id"], t["id_signature"], t["format"], t["cible"],
t["ton"], t["sujet"], t["longueur"],
t["hashes"]["sha256"][:16], t["signature_hmac"][:16]])


