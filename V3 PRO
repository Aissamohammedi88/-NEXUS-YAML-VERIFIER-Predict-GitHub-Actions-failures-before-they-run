}

def valider_fichier(self, chemin):
"""Valide un fichier et retourne un rapport complet."""
p = Path(chemin)
if not p.exists():
return {"ok": False, "err": f"Fichier introuvable : {chemin}"}

ext = p.suffix.lower()
contenu = p.read_text(encoding="utf-8", errors="ignore")

rapport = {
"ok": True,
"fichier": str(p),
"extension": ext,
"taille": len(contenu),
"lignes": contenu.count("\n") + 1,
"hash": hash_multi(contenu),
"score": 100,
"problemes": [],
"avertissements": [],
"infos": [],
}

# Validation selon le langage
if ext in self.langages:
self.langages[ext](contenu, rapport)
else:
rapport["avertissements"].append(f"Extension non supportée : {ext}")
rapport["score"] -= 10

# Vérifications générales
self._verifier_generique(contenu, rapport)

# Score final
rapport["score"] = max(0, min(100, rapport["score"]))
rapport["signature"] = signer_hmac(
json.dumps(rapport["hash"], sort_keys=True),
charger_cle()
)
rapport["id"] = generer_id_signature(contenu)

return rapport

def _verifier_generique(self, contenu, rapport):
"""Vérifications communes à tous les langages."""
# Fichier vide
if not contenu.strip():
rapport["problemes"].append("Fichier vide")
rapport["score"] -= 50

# Lignes trop longues
longues = [i for i, l in enumerate(contenu.split("\n"), 1) if len(l) > 200]
if longues:
rapport["avertissements"].append(
f"{len(longues)} ligne(s) > 200 caractères (lignes {longues[:5]})"
)
rapport["score"] -= min(10, len(longues))

# TODO/FIXME
todos = re.findall(r"(TODO|FIXME|XXX|HACK)", contenu)
if todos:
rapport["avertissements"].append(f"{len(todos)} TODO/FIXME détecté(s)")
rapport["score"] -= min(5, len(todos))

# Secrets en clair
if re.search(r'(password|api_key|secret|token)\s*[:=]\s*["\'][^"\']{8,}["\']',
contenu, re.I):
rapport["problemes"].append("Secret potentiellement en clair")
rapport["score"] -= 30

# Commandes dangereuses
for danger in ["rm -rf /", "sudo rm -rf /", ":(){:|:&};:", "dd if=/dev/zero"]:
if danger in contenu:
rapport["problemes"].append(f"Commande dangereuse : {danger}")
rapport["score"] -= 50

# Encodage
try:
contenu.encode("ascii")
rapport["infos"].append("Fichier ASCII pur")
except UnicodeEncodeError:
rapport["infos"].append("Fichier contient des caractères non-ASCII")

# Fin de ligne
if "\r\n" in contenu:
rapport["avertissements"].append("Fins de ligne CRLF détectées")
rapport["score"] -= 2

def _valider_python(self, contenu, rapport):
"""Validation Python."""
# Indentation mixte
if "\t" in contenu and " " in contenu:
rapport["problemes"].append("Indentation mixte (tabulations + espaces)")
rapport["score"] -= 15

# Imports
imports = re.findall(r"^(?:from\s+(\S+)|import\s+(\S+))", contenu, re.M)
rapport["infos"].append(f"{len(imports)} import(s) détecté(s)")

# Try/except
if "try:" in contenu:
rapport["infos"].append("Gestion d'exceptions présente")

# Fonctions
fns = re.findall(r"^def\s+(\w+)", contenu, re.M)
rapport["infos"].append(f"{len(fns)} fonction(s)")

# Classes
cls = re.findall(r"^class\s+(\w+)", contenu, re.M)
rapport["infos"].append(f"{len(cls)} classe(s)")

# Validation syntaxique
try:
import ast
ast.parse(contenu)
rapport["infos"].append("Syntaxe Python valide")
except SyntaxError as e:
rapport["problemes"].append(f"Erreur syntaxe : ligne {e.lineno}")
rapport["score"] -= 40

def _valider_javascript(self, contenu, rapport):
"""Validation JavaScript/TypeScript."""
# Semicolons manquants
lignes_sans_semicolon = 0
for line in contenu.split("\n"):
s = line.strip()
if s and not s.endswith((";", "{", "}", ",", ")", "(")):
if not s.startswith(("//", "/*", "*")):
lignes_sans_semicolon += 1
if lignes_sans_semicolon > 10:
rapport["avertissements"].append(
f"{lignes_sans_semicolon} ligne(s) sans point-virgule"
)
rapport["score"] -= 5

# var vs let/const
if re.search(r"\bvar\s+", contenu):
rapport["avertissements"].append("Utilisation de 'var' (préférer let/const)")
rapport["score"] -= 5

# console.log
logs = len(re.findall(r"console\.log", contenu))
if logs > 5:
rapport["avertissements"].append(f"{logs} console.log (à retirer en prod)")
rapport["score"] -= min(10, logs)

# async/await
if "async" in contenu and "await" in contenu:
rapport["infos"].append("Code asynchrone présent")

def _valider_go(self, contenu, rapport):
"""Validation Go."""
if "package " not in contenu:
rapport["problemes"].append("Directive 'package' manquante")
rapport["score"] -= 30

if "func " not in contenu and "package main" in contenu:
rapport["avertissements"].append("Package main sans fonction")
rapport["score"] -= 10

# Gestion d'erreurs
err_count = len(re.findall(r"if err\s*!=\s*nil", contenu))
rapport["infos"].append(f"{err_count} vérification(s) d'erreur")

def _valider_rust(self, contenu, rapport):
"""Validation Rust."""
# unsafe
unsafe = len(re.findall(r"\bunsafe\b", contenu))
if unsafe > 0:
rapport["avertissements"].append(f"{unsafe} bloc(s) unsafe")
rapport["score"] -= unsafe * 5

# unwrap
unwraps = len(re.findall(r"\.unwrap\(\)", contenu))
if unwraps > 3:
rapport["avertissements"].append(f"{unwraps} .unwrap() (risque de panic)")
rapport["score"] -= min(15, unwraps * 2)

# expect
if ".expect(" in contenu:
rapport["infos"].append("Utilisation de .expect()")

def _valider_c_cpp(self, contenu, rapport):
"""Validation C/C++."""
# Buffer overflow risks
for danger in ["strcpy(", "strcat(", "sprintf(", "gets("]:
n = contenu.count(danger)
if n > 0:
rapport["problemes"].append(
f"{n} utilisation(s) de {danger} (buffer overflow possible)"
)
rapport["score"] -= n * 10

# Free sans null
frees = len(re.findall(r"\bfree\s*\(", contenu))
if frees > 0:
rapport["infos"].append(f"{frees} appel(s) à free()")

# Includes
includes = re.findall(r'#include\s*[<"]([^>"]+)[>"]', contenu)
rapport["infos"].append(f"{len(includes)} include(s)")

def _valider_bash(self, contenu, rapport):
"""Validation Bash."""
# Shebang
if not contenu.startswith("#!"):
rapport["avertissements"].append("Shebang manquant")
rapport["score"] -= 10

# set -e
if "set -e" not in contenu and "set -euo" not in contenu:
rapport["avertissements"].append("'set -e' recommandé pour arrêter en cas d'erreur")
rapport["score"] -= 5

# Variables non quotées
non_quotees = len(re.findall(r"\$\w+(?!\")", contenu))
if non_quotees > 10:
rapport["avertissements"].append(
f"{non_quotees} variables potentiellement non-quotées"
)
rapport["score"] -= 5

def _valider_yaml(self, contenu, rapport):
"""Validation YAML."""
try:
import yaml
data = yaml.safe_load(contenu)
if data is None:
rapport["problemes"].append("YAML vide")
rapport["score"] -= 30
else:
rapport["infos"].append("YAML syntaxiquement valide")
except ImportError:
rapport["avertissements"].append("pyyaml non installé")
except Exception as e:
rapport["problemes"].append(f"Erreur YAML : {str(e)[:100]}")
rapport["score"] -= 40

def _valider_json(self, contenu, rapport):
"""Validation JSON."""
try:
json.loads(contenu)
rapport["infos"].append("JSON valide")
except json.JSONDecodeError as e:
rapport["problemes"].append(f"JSON invalide : ligne {e.lineno}")
rapport["score"] -= 40


