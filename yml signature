GH_UA = "NexusYamlVerifier/" + VERSION





def gh_api(path, token=None):

    url = "https://api.github.com" + path

    h = {"User-Agent": GH_UA, "Accept": "application/vnd.github+json"}

    if token:

        h["Authorization"] = "Bearer " + token

    try:

        req = urllib.request.Request(url, headers=h)

        ctx = ssl.create_default_context()

        ctx.check_hostname = False

        ctx.verify_mode = ssl.CERT_NONE

        with urllib.request.urlopen(req, timeout=20, context=ctx) as r:

            return {"ok": True, "data": json.loads(r.read().decode("utf-8", "ignore"))}

    except urllib.error.HTTPError as e:

        return {"ok": False, "status": e.code, "err": "HTTP " + str(e.code)}

    except Exception as e:

        return {"ok": False, "status": 0, "err": str(e)[:150]}





def gh_list_workflows(repo, token=None):

    """Liste les workflows d'un repo GitHub."""

    r = gh_api("/repos/" + repo + "/contents/.github/workflows", token=token)

    if not r.get("ok"):

        return {"ok": False, "err": r.get("err", "?")}

    items = r["data"]

    if not isinstance(items, list):

        return {"ok": False, "err": "réponse inattendue"}

    out = []

    for it in items:

        if it.get("type") == "file" and it.get("name", "").endswith((".yml", ".yaml")):

            out.append({

                "name": it["name"],

                "path": it["path"],

                "size": it.get("size", 0),

                "sha": it.get("sha", "")[:12],

                "download_url": it.get("download_url", ""),

            })

    return {"ok": True, "workflows": out}





def gh_fetch_workflow(repo, path, token=None):

    """Récupère le contenu d'un workflow."""

    r = gh_api("/repos/" + repo + "/contents/" + path, token=token)

    if not r.get("ok"):

        return {"ok": False, "err": r.get("err", "?")}

    item = r["data"]

    if item.get("encoding") == "base64":

        try:

            content = base64.b64decode(item["content"]).decode("utf-8", "ignore")

        except Exception as e:

            return {"ok": False, "err": "decode err : " + str(e)[:100]}

    else:

        content = item.get("content", "")

    return {"ok": True, "content": content, "size": item.get("size", 0)}





