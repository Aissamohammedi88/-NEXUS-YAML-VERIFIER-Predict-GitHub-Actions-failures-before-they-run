# SIMULATION RUNTIME

# ═══════════════════════════════════════════════════════════════════════════



def simuler_run(data):

    """

    Simule l'exécution d'un workflow GitHub Actions.

    Retourne : statut, durée en ms, erreur, étapes OK/KO, log par étape.

    """

    t0 = time.time()

    r = {

        "statut": "SUCCESS",

        "duree_ms": 0,

        "erreur": "",

        "etapes_ok": 0,

        "etapes_ko": 0,

        "log": [],

    }

    if not isinstance(data, dict):

        r["statut"] = "FAIL"

        r["erreur"] = "Structure YAML invalide"

        r["duree_ms"] = int((time.time() - t0) * 1000)

        return r



    jobs = data.get("jobs", {})

    if not isinstance(jobs, dict):

        r["statut"] = "FAIL"

        r["erreur"] = "Section 'jobs' invalide"

        r["duree_ms"] = int((time.time() - t0) * 1000)

        return r



    for nom_job, job in jobs.items():

        # Vérifie runs-on (compatibilité runner)

        runs_on = job.get("runs-on", "")

        if isinstance(runs_on, list):

            runs_on = runs_on[0] if runs_on else ""

        runs_on = str(runs_on).lower()

        if runs_on and runs_on not in ("ubuntu-latest", "ubuntu-22.04",

                                        "ubuntu-20.04", "ubuntu-24.04",

                                        "macos-latest", "macos-14",

                                        "windows-latest", "windows-2022",

                                        "self-hosted"):

            r["etapes_ko"] += 1

            r["statut"] = "FAIL"

            r["erreur"] = "Runner inconnu : " + str(runs_on)

            r["log"].append("[FAIL] " + nom_job + " : runner " + str(runs_on) + " introuvable")

            r["duree_ms"] = int((time.time() - t0) * 1000)

            return r



        steps = job.get("steps", [])

        if not isinstance(steps, list):

            r["etapes_ko"] += 1

            r["statut"] = "FAIL"

            r["erreur"] = "steps invalide pour " + nom_job

            r["duree_ms"] = int((time.time() - t0) * 1000)

            return r



        for i, st in enumerate(steps):

            if not isinstance(st, dict):

                r["etapes_ko"] += 1

                r["statut"] = "FAIL"

                r["erreur"] = "step invalide " + nom_job + "#" + str(i)

                r["duree_ms"] = int((time.time() - t0) * 1000)

                return r



            # Simule le step

            nom_step = st.get("name", "step-" + str(i))

            if "uses" in st:

                act = str(st["uses"])

                # Vérifie actions officielles connues

                actions_connues = (

                    "actions/checkout", "actions/setup-python",

                    "actions/setup-node", "actions/setup-go",

                    "actions/setup-java", "actions/cache",

                    "actions/upload-artifact", "actions/download-artifact",

                    "docker/build-push-action", "docker/login-action",

                    "docker/setup-buildx-action", "docker/setup-qemu-action",

                    "github/codeql-action", "codecov/codecov-action",

                )

                if not any(act.startswith(a) for a in actions_connues):

                    # Action inconnue — avertissement mais pas fail

                    r["log"].append("[WARN] " + nom_job + "#" + str(i) + " : action " + act + " non reconnue")

                r["etapes_ok"] += 1

                r["log"].append("[OK]   " + nom_job + "#" + str(i) + " : " + act)



            elif "run" in st:

                cmd = str(st["run"])

                # Simule l'exécution : vérifie cohérence des commandes

                if not cmd.strip():

                    r["etapes_ko"] += 1

                    r["statut"] = "FAIL"

                    r["erreur"] = "step " + nom_job + "#" + str(i) + " : commande vide"

                    r["duree_ms"] = int((time.time() - t0) * 1000)

                    return r



                # Détecte les commandes qui échouent souvent

                if "npm install" in cmd and "package.json" not in str(data):

                    r["log"].append("[WARN] " + nom_job + "#" + str(i) + " : npm install sans package.json")

                if "pip install" in cmd and "requirements.txt" not in cmd and "-r" in cmd:

                    r["log"].append("[WARN] " + nom_job + "#" + str(i) + " : requirements.txt introuvable")



                r["etapes_ok"] += 1

                r["log"].append("[OK]   " + nom_job + "#" + str(i) + " : run (" + str(len(cmd)) + " chars)")



            time.sleep(0.01)  # Simule latence par step



    r["duree_ms"] = int((time.time() - t0) * 1000)

    return r





