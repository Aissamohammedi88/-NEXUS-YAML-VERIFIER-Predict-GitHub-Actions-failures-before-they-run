                state_update(valides=STATE["valides"] + 1)

            else:

                state_update(invalides=STATE["invalides"] + 1)

            if r["est_workflow"]:

                state_update(workflows=STATE["workflows"] + 1)

            with STATE_LK:

                STATE.setdefault("runs", []).append({

                    "nom": r["nom"], "statut": r.get("run_statut", ""),

                    "ms": r.get("run_ms", 0), "ts": time.time(),

                })

                if len(STATE["runs"]) > 100:

                    STATE["runs"] = STATE["runs"][-100:]

