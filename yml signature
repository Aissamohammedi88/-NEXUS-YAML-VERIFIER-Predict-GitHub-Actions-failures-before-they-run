def valider_yaml(contenu):

    r = {"valide": False, "erreur": None, "data": None,

         "taille": len(contenu), "lignes": contenu.count("\n") + 1}

    try:

        data = yaml.safe_load(contenu)

        if data is None:

            r["erreur"] = "Fichier vide"

            return r

        r["valide"] = True

        r["data"] = data

    except yaml.YAMLError as e:

        m = getattr(e, "problem_mark", None)

        if m:

            r["erreur"] = "Ligne " + str(m.line + 1) + " col " + str(m.column + 1) + " : " + str(e.problem or e)[:160]

        else:

            r["erreur"] = str(e)[:200]

    except Exception as e:

        r["erreur"] = str(e)[:200]

    return r





def verifier_workflow(data):

    """Vérifie la structure d'un GitHub Actions workflow."""

    r = {"score": 100, "problemes": [], "avertissements": [], "infos": [],

         "jobs": 0, "steps": 0}

    if not isinstance(data, dict):

        r["problemes"].append("Objet YAML attendu")

        r["score"] = 0

        return r

    if "on" not in data:

        r["problemes"].append("Section 'on' manquante")

    if "jobs" not in data:

        r["problemes"].append("Section 'jobs' manquante")

        r["score"] = 0

        return r

    jobs = data.get("jobs", {})

    if not isinstance(jobs, dict) or not jobs:

        r["problemes"].append("Aucun job")

        r["score"] = 0

        return r

    r["jobs"] = len(jobs)

    for nom, job in jobs.items():

        if not isinstance(job, dict):

            r["problemes"].append("Job " + nom + " : objet attendu")

            continue

        if "runs-on" not in job:

            r["problemes"].append("Job " + nom + " : 'runs-on' manquant")

        steps = job.get("steps", [])

        if not isinstance(steps, list) or not steps:

            r["problemes"].append("Job " + nom + " : steps manquant")

            continue

        r["steps"] += len(steps)

        for i, st in enumerate(steps):

            if not isinstance(st, dict):

                continue

            if "uses" not in st and "run" not in st:

                r["problemes"].append("Job " + nom + " step " + str(i) + " : 'uses' ou 'run' manquant")

            if "uses" in st:

                a = str(st["uses"])

                if "@" not in a:

                    r["avertissements"].append("Job " + nom + " step " + str(i) + " : version manquante (" + a + ")")

            if "run" in st and isinstance(st["run"], str):

                cmd = st["run"]

                for d in ("rm -rf /", "sudo rm -rf /", "dd if=/dev/zero", ":(){:|:&};:"):

                    if d in cmd:

                        r["problemes"].append("Job " + nom + " step " + str(i) + " : dangereux (" + d + ")")

                if re.search(r"(password|api_key|secret|token)\s*[:=]\s*['\"][^'\"]{8,}['\"]", cmd, re.I):

                    r["avertissements"].append("Job " + nom + " step " + str(i) + " : secret en clair")

    if "permissions" not in data:

        r["avertissements"].append("Section 'permissions' manquante")

    score = 100 - len(r["problemes"]) * 15 - len(r["avertissements"]) * 5

    r["score"] = max(0, min(100, score))

    return r





