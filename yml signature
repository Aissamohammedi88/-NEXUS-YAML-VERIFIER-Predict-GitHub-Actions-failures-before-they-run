    def log_message(self, *a):

        pass



    def _send(self, code, body, ctype="text/html; charset=utf-8"):

        if isinstance(body, str):

            body = body.encode("utf-8")

        try:

            self.send_response(code)

            self.send_header("Content-Type", ctype)

            self.send_header("Content-Length", str(len(body)))

            self.send_header("Access-Control-Allow-Origin", "*")

            self.send_header("Cache-Control", "no-store")

            self.end_headers()

            self.wfile.write(body)

        except (BrokenPipeError, ConnectionResetError):

            pass



    def _json(self, code, obj):

        self._send(code, json.dumps(obj, indent=2, ensure_ascii=False, default=str),

                   "application/json; charset=utf-8")



    def do_GET(self):

        p = urllib.parse.urlparse(self.path)

        path = p.path

        qs = urllib.parse.parse_qs(p.query)



        if path in ("/", "/index.html"):

            html = HTML_PAGE.replace("__VERSION__", VERSION)

            return self._send(200, html)



        if path == "/api/state":

            return self._json(200, state_get())



        if path == "/api/status":

            return self._json(200, {

                "ok": True, "service": "NEXUS YAML VERIFIER",

                "version": VERSION, "auteur": AUTEUR,

                "port": HTTP_PORT, "running": STATE["running"],

            })



        if path == "/api/repo":

            repo = qs.get("repo", [""])[0].strip()

            if not repo or "/" not in repo:

                return self._json(400, {"ok": False, "err": "repo invalide (owner/name)"})

            r = gh_fetch_repo(repo)

