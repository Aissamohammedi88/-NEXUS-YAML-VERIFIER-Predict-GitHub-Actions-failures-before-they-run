def analyser_contenu(contenu, source, chemin, nom, key):

    """Analyse complète : syntaxe + workflow + simulation run."""

    r = {

        "source": source, "chemin": chemin, "nom": nom,

        "taille": len(contenu), "lignes": contenu.count("\n") + 1,

        "hash_sha256": hashlib.sha256(contenu.encode("utf-8")).hexdigest(),

        "valide_syntaxe": 0, "erreur_syntaxe": "",

        "est_workflow": 1 if (".github/workflows" in chemin or source == "github") else 0,

        "score": 0, "probleme": [], "avertissement": [], "info": [],

        "run_statut": "", "run_erreur": "", "run_ms": 0,

    }

    v = valider_yaml(contenu)

    if not v["valide"]:

        r["erreur_syntaxe"] = v["erreur"] or ""

        r["probleme"].append("Syntaxe : " + str(v["erreur"]))

        return r

    r["valide_syntaxe"] = 1

    if r["est_workflow"] and isinstance(v["data"], dict):

        wf = verifier_workflow(v["data"])

        r["score"] = wf["score"]

        r["probleme"] = wf["problemes"]

        r["avertissement"] = wf["avertissements"]

        r["info"] = wf["infos"]

        # Simulation runtime

        run = simuler_run(v["data"])

        r["run_statut"] = run["statut"]

        r["run_erreur"] = run["erreur"]

        r["run_ms"] = run["duree_ms"]

        r["info"].append("Run : " + run["statut"] + " en " + str(run["run_ms"]) + "ms")

        r["info"].append("Steps : " + str(run["etapes_ok"]) + " OK / " + str(run["etapes_ko"]) + " KO")

    else:

        r["score"] = 100

    sig_data = (r["hash_sha256"] + "|" + r["nom"] + "|" + str(r["score"])).encode()

    r["signature_hmac"] = signer(sig_data, key)

    r["etat_verification"] = "Verified" if r["valide_syntaxe"] else "Non vérifié"

    return r





def sauver_resultat(conn, r):

