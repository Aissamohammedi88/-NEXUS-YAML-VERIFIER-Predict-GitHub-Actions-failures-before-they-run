# ─────────────────────────────────────────────────────────────────────────
# GÉNÉRATION MASSIVE
# ─────────────────────────────────────────────────────────────────────────
generate_all() {
local count=$1
local type=$2

info "Génération de $count fichiers (type : $type)"
echo ""

local counter=0
local start_time=$(date +%s)

for i in $(seq 1 "$count"); do
case "$type" in
readme) gen_readme "$i" ;;
spec) gen_spec "$i" ;;
contract) gen_contract "$i" ;;
proposal) gen_proposal "$i" ;;
whitepaper) gen_whitepaper "$i" ;;
docs) gen_docs "$i" ;;
all)
gen_readme "$i"
gen_spec "$i"
gen_contract "$i"
gen_proposal "$i"
gen_whitepaper "$i"
gen_docs "$i"
;;
esac

counter=$((counter + 1))

# Afficher progrès tous les 50 fichiers
if [ $((counter % 50)) -eq 0 ]; then
printf "\r 📄 %d fichiers générés..." "$counter"
fi
done

echo ""
echo ""

local end_time=$(date +%s)
local duration=$((end_time - start_time))

# Compter les fichiers créés
local total_files=$(find "$OUTPUT_DIR" -type f -name "*.md" | wc -l)
local total_size=$(du -sh "$OUTPUT_DIR" | cut -f1)

echo ""
printf "${G}╔══════════════════════════════════════════════════════════════╗${N}\n"
printf "${G}║ ✅ GÉNÉRATION TERMINÉE ║${N}\n"
printf "${G}╚══════════════════════════════════════════════════════════════╝${N}\n"
echo ""
printf " 📁 Dossier : ${C}%s${N}\n" "$OUTPUT_DIR"
printf " 📄 Fichiers : ${C}%s${N}\n" "$total_files"
printf " 💾 Taille totale : ${C}%s${N}\n" "$total_size"
printf " ⏱️ Durée : ${C}%s secondes${N}\n" "$duration"
echo ""
printf " 📂 Détail par type :\n"
printf " • readme : %s fichiers\n" "$(ls -1 "$OUTPUT_DIR/readme" 2>/dev/null | wc -l)"
printf " • specs : %s fichiers\n" "$(ls -1 "$OUTPUT_DIR/specs" 2>/dev/null | wc -l)"
printf " • contracts : %s fichiers\n" "$(ls -1 "$OUTPUT_DIR/contracts" 2>/dev/null | wc -l)"
printf " • proposals : %s fichiers\n" "$(ls -1 "$OUTPUT_DIR/proposals" 2>/dev/null | wc -l)"
printf " • whitepapers: %s fichiers\n" "$(ls -1 "$OUTPUT_DIR/whitepapers" 2>/dev/null | wc -l)"
printf " • docs : %s fichiers\n" "$(ls -1 "$OUTPUT_DIR/docs" 2>/dev/null | wc -l)"
echo ""
printf " 🧬 ${M}%s — %s${N}\n" "$AUTHOR" "$COMPANY"
printf " 📌 %s\n" "$DATE"
echo ""
}

# ─────────────────────────────────────────────────────────────────────────
# MAIN
