echo "id,id_signature,format,cible,ton,sujet,longueur,sha256,hmac"
for i in $(seq 1 "$count"); do
echo "${TEXTE_ID[$i]},${TEXTE_ID_SIG[$i]},${TEXTE_FORMAT[$i]},${TEXTE_CIBLE[$i]},${TEXTE_TON[$i]},\"${TEXTE_SUJET[$i]:0:50}\",${TEXTE_LONGUEUR[$i]},${TEXTE_SHA256[$i]:0:16},${TEXTE_HMAC[$i]:0:16}"
done
} > "$path"
}

# ───────────────────────────────────────────────────────────────────────────
# MAIN
# ───────────────────────────────────────────────────────────────────────────
main() {
local mode="generate"
local count=1000
local format="all"
local fichier=""

# Parse args
while [ $# -gt 0 ]; do
case "$1" in
--count) count="$2"; shift 2 ;;
--format) format="$2"; shift 2 ;;
--validate) mode="validate"; fichier="$2"; shift 2 ;;
--hash) mode="hash"; fichier="$2"; shift 2 ;;
--sign) mode="sign"; fichier="$2"; shift 2 ;;
*) shift ;;
esac
done

echo ""
echo "==========================================================================="
echo " 🧬 NEXUS ULTIMATE GENERATOR v$VERSION — BASH EDITION"
echo " Auteur : $AUTEUR"
echo " Licence : $LICENCE"
echo "==========================================================================="
echo ""

# Mode validate
if [ "$mode" = "validate" ]; then
valider_fichier "$fichier"
return
fi

# Mode hash
if [ "$mode" = "hash" ]; then
if [ ! -f "$fichier" ]; then
err "Fichier introuvable : $fichier"
return 1
fi
info "Hash de : $fichier"
echo ""
hash_multi "$(cat "$fichier")"
return
fi

# Mode sign
if [ "$mode" = "sign" ]; then
if [ ! -f "$fichier" ]; then
err "Fichier introuvable : $fichier"
return 1
fi
local key
key=$(charger_cle)
local contenu
contenu=$(cat "$fichier")
info "Signature de : $fichier"
echo ""
echo "ID signature : $(generer_id_signature "$contenu")"
echo "HMAC-SHA256 : $(signer_hmac "$contenu" "$key")"
echo "PBKDF2 : $(signer_pbkdf2 "$contenu" "$key")"
return
fi

# Mode générateur
info "Nombre de textes : $count"
info "Format : $format"
info "Cibles : ${#CIBLES[@]} entreprises"
info "Formats cibles : ${#FORMATS[@]} formats"
echo ""

local key
key=$(charger_cle)

declare -A TEXTE_ID TEXTE_FORMAT TEXTE_CIBLE TEXTE_TON TEXTE_SUJET TEXTE_CORPS
declare -A TEXTE_SHA256 TEXTE_HMAC TEXTE_PBKDF2 TEXTE_ID_SIG TEXTE_LONGUEUR

local start
start=$(date +%s)

info "Génération en cours..."
for i in $(seq 1 "$count"); do
generer_texte "$i" "$key"
if [ $((i % 100)) -eq 0 ] || [ "$i" -eq "$count" ]; then
local pct=$((i * 100 / count))
printf "\r [%d%%] %d/%d" "$pct" "$i" "$count"
fi
done
echo ""
echo ""

local end
end=$(date +%s)
local elapsed=$((end - start))
ok "$count textes générés en ${elapsed}s"
echo ""

local ts
ts=$(date +%Y%m%d_%H%M%S)

if [ "$format" = "json" ] || [ "$format" = "all" ]; then
export_json "$OUTPUT_DIR/textes_$ts.json" "$count"
ok "JSON : $OUTPUT_DIR/textes_$ts.json"
fi
if [ "$format" = "txt" ] || [ "$format" = "all" ]; then
export_txt "$OUTPUT_DIR/textes_$ts.txt" "$count"
ok "TXT : $OUTPUT_DIR/textes_$ts.txt"
fi
if [ "$format" = "markdown" ] || [ "$format" = "all" ]; then
export_markdown "$OUTPUT_DIR/textes_$ts.md" "$count"
ok "Markdown : $OUTPUT_DIR/textes_$ts.md"
fi
if [ "$format" = "csv" ] || [ "$format" = "all" ]; then
export_csv "$OUTPUT_DIR/textes_$ts.csv" "$count"
ok "CSV : $OUTPUT_DIR/textes_$ts.csv"
fi

echo ""
echo "==========================================================================="
echo " ✅ GÉNÉRATION TERMINÉE"
echo "==========================================================================="
echo ""
echo " 📂 Dossier : $OUTPUT_DIR"
echo " 🎯 Total : $count textes"
echo ""
echo " 📖 Aperçu du texte #1 :"
echo " ─────────────────────────────────────────────────────────────────"
echo "${TEXTE_CORPS[1]}" | head -10 | sed 's/^/ /'
echo " ─────────────────────────────────────────────────────────────────"
echo " ID signature : ${TEXTE_ID_SIG[1]}"
echo " SHA-256 : ${TEXTE_SHA256[1]:0:48}..."
echo " HMAC : ${TEXTE_HMAC[1]:0:48}..."
echo ""
}

main "$@"
