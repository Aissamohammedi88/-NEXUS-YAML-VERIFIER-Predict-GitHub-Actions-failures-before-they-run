# ───────────────────────────────────────────────────────────────────────────
# CRYPTO — CLÉ + HASH + SIGNATURE
# ───────────────────────────────────────────────────────────────────────────
charger_cle() {
if [ ! -f "$KEY_FILE" ]; then
openssl rand -hex 64 > "$KEY_FILE"
chmod 600 "$KEY_FILE"
fi
cat "$KEY_FILE"
}

hash_multi() {
local data="$1"
echo "sha256: $(printf '%s' "$data" | sha256sum | cut -d' ' -f1)"
echo "sha512: $(printf '%s' "$data" | sha512sum | cut -d' ' -f1)"
echo "sha1: $(printf '%s' "$data" | sha1sum | cut -d' ' -f1)"
echo "md5: $(printf '%s' "$data" | md5sum | cut -d' ' -f1)"
if command -v b2sum &>/dev/null; then
echo "blake2b: $(printf '%s' "$data" | b2sum | cut -d' ' -f1)"
fi
if command -v sha3sum &>/dev/null; then
echo "sha3_256: $(printf '%s' "$data" | sha3sum -a 256 2>/dev/null | cut -d' ' -f1)"
fi
}

signer_hmac() {
local data="$1"
local key="$2"
printf '%s' "$data" | openssl dgst -sha256 -hmac "$key" | cut -d' ' -f2
}

signer_pbkdf2() {
local data="$1"
local key="$2"
printf '%s' "$data" | openssl dgst -sha512 -hmac "$key" | cut -d' ' -f2
}

generer_id_signature() {
local data="$1"
local h
h=$(printf '%s' "$data" | sha256sum | cut -c1-16 | tr 'a-f' 'A-F')
echo "NEXUS-$h"
}

# ───────────────────────────────────────────────────────────────────────────
# VALIDATEUR DE CODE MULTI-LANGAGE
# ───────────────────────────────────────────────────────────────────────────
valider_fichier() {
local fichier="$1"
if [ ! -f "$fichier" ]; then
err "Fichier introuvable : $fichier"
return 1
fi

local ext="${fichier##*.}"
local taille
taille=$(stat -c%s "$fichier" 2>/dev/null || stat -f%z "$fichier" 2>/dev/null)
local lignes
lignes=$(wc -l < "$fichier")
local contenu
contenu=$(cat "$fichier")

local score=100
local problemes=()
local avertissements=()
local infos=()

info "Fichier : $fichier"
info "Extension : .$ext"
info "Taille : $taille octets"
info "Lignes : $lignes"
echo ""

# Hash complet
echo -e "${C}═══ HASH ═══${N}"
hash_multi "$contenu"
echo ""

# Vérifications générales
if [ ! -s "$fichier" ]; then
problemes+=("Fichier vide")
score=$((score - 50))
fi

# Lignes longues
local longues
longues=$(awk 'length > 200' "$fichier" | wc -l)
if [ "$longues" -gt 0 ]; then
avertissements+=("$longues ligne(s) > 200 caractères")
score=$((score - longues))
fi

# TODO/FIXME
local todos
todos=$(grep -cE "(TODO|FIXME|XXX|HACK)" "$fichier" 2>/dev/null || echo 0)
if [ "$todos" -gt 0 ]; then
avertissements+=("$todos TODO/FIXME détecté(s)")
score=$((score - todos))
fi

# Secrets en clair
if grep -qE '(password|api_key|secret|token)\s*[:=]\s*["'"'"'][^"'"'"']{8,}["'"'"']' "$fichier" 2>/dev/null; then
problemes+=("Secret potentiellement en clair")
score=$((score - 30))
fi

# Commandes dangereuses
for danger in "rm -rf /" "sudo rm -rf /" "dd if=/dev/zero"; do
if grep -qF "$danger" "$fichier" 2>/dev/null; then
problemes+=("Commande dangereuse : $danger")
score=$((score - 50))
fi
done

# Validations spécifiques par langage
case ".$ext" in
.py)
if grep -qP "\t" "$fichier" 2>/dev/null && grep -q " " "$fichier" 2>/dev/null; then
problemes+=("Indentation mixte (tabs + espaces)")
score=$((score - 15))
fi
local fns
fns=$(grep -cE "^def\s+\w+" "$fichier" 2>/dev/null || echo 0)
infos+=("$fns fonction(s)")
local cls
cls=$(grep -cE "^class\s+\w+" "$fichier" 2>/dev/null || echo 0)
infos+=("$cls classe(s)")
if python3 -c "import ast; ast.parse(open('$fichier').read())" 2>/dev/null; then
infos+=("Syntaxe Python valide")
else
problemes+=("Erreur de syntaxe Python")
score=$((score - 40))
fi
;;
.js|.ts)
if grep -qE "\bvar\s+" "$fichier" 2>/dev/null; then
avertissements+=("Utilisation de 'var' (préférer let/const)")
score=$((score - 5))
fi
local logs
logs=$(grep -c "console\.log" "$fichier" 2>/dev/null || echo 0)
if [ "$logs" -gt 5 ]; then
avertissements+=("$logs console.log (à retirer en prod)")
score=$((score - 10))
fi
;;
.go)
if ! grep -q "^package " "$fichier" 2>/dev/null; then
problemes+=("Directive 'package' manquante")
score=$((score - 30))
fi
local errs
errs=$(grep -cE "if err\s*!=\s*nil" "$fichier" 2>/dev/null || echo 0)
infos+=("$errs vérification(s) d'erreur")
;;
.rs)
local unsafe
unsafe=$(grep -cE "\bunsafe\b" "$fichier" 2>/dev/null || echo 0)
if [ "$unsafe" -gt 0 ]; then
avertissements+=("$unsafe bloc(s) unsafe")
score=$((score - unsafe * 5))
fi
local unwraps
unwraps=$(grep -c "\.unwrap()" "$fichier" 2>/dev/null || echo 0)
if [ "$unwraps" -gt 3 ]; then
avertissements+=("$unwraps .unwrap() (risque de panic)")
score=$((score - 10))
fi
;;
.c|.cpp|.h|.hpp)
for danger in "strcpy(" "strcat(" "sprintf(" "gets("; do
local n
n=$(grep -cF "$danger" "$fichier" 2>/dev/null || echo 0)
if [ "$n" -gt 0 ]; then
problemes+=("$n utilisation(s) de $danger (buffer overflow)")
score=$((score - n * 10))
fi
done
;;
.sh|.bash)
if ! head -1 "$fichier" | grep -q "^#!"; then
avertissements+=("Shebang manquant")
score=$((score - 10))
fi
if ! grep -q "set -e" "$fichier" 2>/dev/null; then
avertissements+=("'set -e' recommandé")
score=$((score - 5))
fi
;;
.yml|.yaml)
if python3 -c "import yaml; yaml.safe_load(open('$fichier'))" 2>/dev/null; then
infos+=("YAML syntaxiquement valide")
else
problemes+=("YAML invalide")
score=$((score - 40))
fi
;;
.json)
if python3 -c "import json; json.load(open('$fichier'))" 2>/dev/null; then
infos+=("JSON valide")
else
problemes+=("JSON invalide")
score=$((score - 40))
fi
;;
*)
avertissements+=("Extension non supportée : .$ext")
score=$((score - 10))
;;
esac

# Borne
[ "$score" -lt 0 ] && score=0
[ "$score" -gt 100 ] && score=100

# Signature
local key
key=$(charger_cle)
local sig_hmac
sig_hmac=$(signer_hmac "$contenu" "$key")
local sig_pbkdf2
sig_pbkdf2=$(signer_pbkdf2 "$contenu" "$key")
local id_sig
id_sig=$(generer_id_signature "$contenu")

# Rapport
echo -e "${C}═══ SIGNATURES ═══${N}"
echo "ID signature : $id_sig"
echo "HMAC-SHA256 : $sig_hmac"
echo "PBKDF2 : $sig_pbkdf2"
echo ""

echo -e "${C}═══ RÉSULTAT ═══${N}"
echo -e "${W}Score : $score/100${N}"
echo ""

if [ ${#problemes[@]} -gt 0 ]; then
printf "${R}Problèmes (%d) :${N}\n" "${#problemes[@]}"
for p in "${problemes[@]}"; do echo " ✗ $p"; done
echo ""
fi

if [ ${#avertissements[@]} -gt 0 ]; then
printf "${Y}Avertissements (%d) :${N}\n" "${#avertissements[@]}"
for a in "${avertissements[@]}"; do echo " ⚠ $a"; done
echo ""
fi

if [ ${#infos[@]} -gt 0 ]; then
printf "${B}Infos (%d) :${N}\n" "${#infos[@]}"
for i in "${infos[@]}"; do echo " ℹ $i"; done
echo ""
fi
}

